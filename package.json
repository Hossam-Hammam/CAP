{
  "name": "bookshop",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@ngrok/ngrok": "^1.7.0",
    "@sap/cds": "^9",
    "@sap/cds-common-content": "^3.1.0",
    "cors": "^2.8.6",
    "express": "^4",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^0.4.1",
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9.9.6",
    "cap-listening-plugin": "github:qmacro/cap-listening-plugin",
    "eslint": "^9.39.2"
  },
  "scripts": {
    "prestart": "cds deploy",
    "start": "cds watch",
    "serve": "cds-serve"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "[development]": {
            "url": "bookshop.sqlite"
          }
        }
      },
      "auth": {
        "[development]": {
          "users": {
            "alice": {
              "password": "alice",
              "roles": [
                "POViewer"
              ]
            },
            "carol": {
              "password": "carol",
              "roles": [
                "POViewer",
                "L1Approver"
              ]
            },
            "dave": {
              "password": "dave",
              "roles": [
                "POViewer",
                "L2Approver"
              ]
            },
            "erin": {
              "password": "erin",
              "roles": [
                "POViewer",
                "L1Approver",
                "L2Approver"
              ]
            },
            "bob": {
              "password": "bob",
              "roles": []
            },
            "*": false
          }
        }
      },
      "[production]": {
        "auth": {
          "kind": "xsuaa"
        }
      }
    }
  }
}
